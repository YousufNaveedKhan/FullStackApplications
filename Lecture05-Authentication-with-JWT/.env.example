PORT=3000
MONGO_URI=mongodb://localhost:27017/fullstackApp

# Use a long random text. Anyone who knows it can create valid tokens.
JWT_SECRET=change_this_to_a_long_random_text
JWT_EXPIRES_IN=7d

# Used only by "npm run seed" to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
